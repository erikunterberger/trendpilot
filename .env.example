# --- Market data (Financial Modeling Prep) ---
# Sign up: https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# --- News (NewsAPI) ---
# Sign up: https://newsapi.org/register
NEWSAPI_KEY=

# --- Analysis (Google Gemini, free tier via AI Studio) ---
# Sign up: https://aistudio.google.com/apikey (no credit card required)
GEMINI_API_KEY=
ANALYSIS_MODEL=gemini-2.5-flash

# --- Brokerage account (optional, Alpaca, READ-ONLY) ---
# Lets the agent size in whole shares from your real equity, check your stop
# orders, and keep the dashboard's holdings live. The agent only ever reads;
# it has no code that can place or cancel orders. Use a read-only key if your
# Alpaca dashboard offers one. Paper and live accounts have separate keys —
# set ALPACA_ENV to match (paper | live). Leave blank to skip.
# Sign up: https://alpaca.markets
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_ENV=paper
# Optional: let the agent place its own trades in the PAPER account (fake
# money). Only "paper" is accepted, and only when ALPACA_ENV=paper — there
# is no live auto-trading. Needs a paper key with trading permission.
# ALPACA_AUTOTRADE=paper

# --- Obsidian (optional) ---
# Save each report into an Obsidian vault and read recent ones back for
# continuity. Leave unset to skip.
# OBSIDIAN_VAULT_DIR=C:\path\to\your\vault

# --- Email delivery (optional, only needed if you run with --email) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
